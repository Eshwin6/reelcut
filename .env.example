# Add these as Secrets in your Hugging Face Space (Settings -> Variables and secrets)

APP_PASSWORD=pick-a-strong-password      # protects the app
HF_TOKEN=hf_...                           # keeps brands/music/accounts saved through restarts (write token)

# Instagram auto-posting (free Meta developer app, "Instagram API with Instagram Login")
IG_APP_ID=
IG_APP_SECRET=

# TikTok auto-posting (free TikTok developer app, Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PRIVACY=SELF_ONLY                  # PUBLIC_TO_EVERYONE once TikTok approves your app

# Later, when you want the AI (paid, a few cents per video):
# ANTHROPIC_API_KEY=sk-ant-...

# Optional
# WHISPER_LANG=en
# KEEP_DAYS=3                             # how long finished videos are kept
